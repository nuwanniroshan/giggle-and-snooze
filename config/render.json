{
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "upscale": 4,
  "lead_in": 0.6,
  "hold": 1.0,
  "transition": 0.8,
  "transition_style": "slideleft",
  "back_cover_seconds": 2.5,
  "motion": {
    "push_zoom": 1.12,
    "pan_zoom": 1.12,
    "pan_travel": 0.06,
    "qa_ease": 1.2,
    "intro_zoom": 1.15,
    "outro_zoom": 1.15,
    "outro_fade": 1.0
  },
  "backdrop": {"blur": 30, "darken": 0.55},
  "captions": {
    "font_size": 48,
    "max_chars": 44,
    "max_lines": 2,
    "min_card_seconds": 1.2,
    "band_opacity": 0.6,
    "margin": 48,
    "padding": 24,
    "font": "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "fallback_font": "/System/Library/Fonts/Supplemental/Times New Roman.ttf"
  },
  "audio": {
    "peak_dbfs": -1.0,
    "sfx_gain_db": -6.0,
    "ambience_gain_db": -14.0,
    "ambience_fade": 1.5,
    "loop_crossfade": 1.0
  },
  "video": {"crf": 18, "preset": "medium", "audio_bitrate": "192k", "audio_rate": 48000}
}
