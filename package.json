{
  "name": "giggle-and-snooze",
  "private": true,
  "description": "Monorepo: Python studio & video pipeline (apps/studio), public web app (apps/web), Supabase (supabase/).",
  "scripts": {
    "dev": "node scripts/dev-launcher.mjs both",
    "web": "node scripts/dev-launcher.mjs web",
    "web:start": "node scripts/dev-launcher.mjs web-start",
    "web:build": "node scripts/dev-launcher.mjs web-build",
    "web:typecheck": "node scripts/dev-launcher.mjs web-typecheck",
    "studio": "node scripts/dev-launcher.mjs studio",
    "studio:test": "uv --directory apps/studio run pytest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "supabase": "^3.1.0"
  }
}
