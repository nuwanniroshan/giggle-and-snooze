+  // Open a book from `/?src=<url>` (Giggle & Snooze storefront handoff): fetch the
+  // EPUB, import it like a picked file, then open it in the reader.
+  const srcParam = searchParams?.get('src') || '';
+  const srcHandled = useRef<string | null>(null);
+  useEffect(() => {
+    if (!srcParam || !appService || !libraryLoaded) return;
+    if (srcHandled.current === srcParam) return;
+    srcHandled.current = srcParam;
+    (async () => {
+      try {
+        const url = new URL(srcParam);
+        if (url.protocol !== 'https:' && url.protocol !== 'http:') throw new Error('bad src');
+        const res = await fetch(url.toString());
+        if (!res.ok) throw new Error(`HTTP ${res.status}`);
+        const blob = await res.blob();
+        const name = decodeURIComponent(url.pathname.split('/').pop() || '') || 'book.epub';
+        const file = new File([blob], /\.epub$/i.test(name) ? name : `${name}.epub`, {
+          type: 'application/epub+zip',
+        });
+        const { importedHashes } = await importBooks([{ file }], '');
+        const params = new URLSearchParams(window.location.search);
+        params.delete('src');
+        navigateToLibrary(router, params.toString());
+        if (importedHashes[0]) setPendingNavigationBookIds([importedHashes[0]]);
+      } catch (error) {
+        console.error('Failed to open book from src:', error);
+        eventDispatcher.dispatch('toast', {
+          message: _('Failed to open the book. The link may have expired.'),
+          timeout: 5000,
+          type: 'error',
+        });
+      }
+    })();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [srcParam, appService, libraryLoaded]);
